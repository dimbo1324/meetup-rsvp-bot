# Шаблон настроек бота. Скопируйте в .env и заполните СВОИМИ значениями.
# Файл .env в git не попадает; на сервере ему нужны права 600 (chmod 600 .env).
# Подробно: README.md, раздел 15 спецификации (docs/spec/15-configuration.md).
#
# Локально (разработка и проверка): токен СВОЕГО тестового бота и ENV=dev.
# На сервере (прод): токен боевого бота локации и ENV=prod.
# Один токен — один запущенный процесс: два бота с одним токеном перехватывают
# друг у друга обновления. Боевой токен живёт только в .env на сервере.

# Токен из @BotFather (/newbot или /token), вида 123456789:AA... Обязателен.
BOT_TOKEN=

# Telegram ID владельцев через запятую, без пробелов. Обязателен (хотя бы один).
# Владельцы — всегда админы и единственные, кто назначает других админов.
# Свой ID бот покажет в ответ на /start, если запущен с ENV=dev.
OWNER_IDS=

# ID служебного чата: закрытая группа (владелец, бот, позже ведущие). Обязателен.
# Обычно отрицательное число, у супергрупп начинается с -100. При ENV=dev бот сам
# пишет ID чата, когда его добавляют в группу. Бот должен состоять в этой группе.
SERVICE_CHAT_ID=

# Путь к базе SQLite. Локально подходит значение ниже; в Docker его переопределяет
# compose.yaml (/app/data/bot.db), здесь менять не нужно.
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# dev — локальная проверка: бот показывает ID на /start и при добавлении в группу,
#       работает команда /dev_shift (сдвиг часов для проверки напоминаний).
# prod — боевой режим, dev-команды выключены. Если не задано, используется prod.
ENV=dev

# Уровень логов: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Необязательно: DSN проекта в Sentry для отчётов об ошибках. Пусто — выключено.
SENTRY_DSN=
