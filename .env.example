# Скопируйте в .env и заполните СВОИМИ значениями. Файл .env в git не попадает.

# Токен СВОЕГО тестового бота из BotFather (один токен — один процесс long polling).
BOT_TOKEN=
# Telegram ID владельцев через запятую.
OWNER_IDS=
# ID служебного чата админов (бот должен в нём состоять).
SERVICE_CHAT_ID=

DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# dev — подробные логи и dev-команды; prod — боевой режим.
ENV=dev
LOG_LEVEL=INFO
SENTRY_DSN=
