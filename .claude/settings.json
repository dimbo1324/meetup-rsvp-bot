{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(uv run python dev.py list:*)",
      "Bash(uv run python dev.py doctor:*)",
      "Bash(uv run python dev.py lint:*)",
      "Bash(uv run python dev.py format:*)",
      "Bash(uv run python dev.py typecheck:*)",
      "Bash(uv run python dev.py test:*)",
      "Bash(uv run python dev.py quality-gate:*)",
      "Bash(uv run python dev.py sync-agents:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock --check:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -*f*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- .*)",
      "Bash(git restore .*)",
      "Bash(rm -rf docs*)",
      "Bash(rm -rf .ai*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(uv publish*)"
    ]
  }
}
