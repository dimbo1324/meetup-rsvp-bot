# Несекретные настройки rcbot (SPEC.md, 4.4). Скопируйте в .env: uv run python dev.py setup.
# Файл .env в git не попадает. Секреты (номер документа, пароль gub.uy, токен Telegram,
# тема ntfy, @username для CallMeBot) живут только в Windows Credential Manager через keyring
# и задаются мастером `rcbot init`. Сюда их не вписывать.
# Номер этапа и номер заявки мастер `rcbot init` тоже спрашивает и сам пишет в .env.

# Шаг «Agenda» заявки: подставьте номер этапа из адресной строки своей заявки.
RCBOT_AGENDA_URL=https://bpmgob.mec.gub.uy/etapas/ejecutar/<НОМЕР_ЭТАПА>/1
# Номер заявки (trámite) из списка «Bandeja de entrada» — для текста уведомления (SPEC.md, 2.4).
RCBOT_TRAMITE_ID=<НОМЕР_ЗАЯВКИ>
RCBOT_LOCATION_TEXT=Oficina Tramite Extranjeros
RCBOT_DOC_COUNTRY=Rusia
RCBOT_DOC_TYPE=Pasaporte
RCBOT_MONTHS_AHEAD=6
# Адрес API календаря. Пусто — ApiSource выключен, работает DomSource (не чаще раза в 60 с).
# Заполняется после разведки `rcbot discover` (этап 3); допустим только https на bpmgob.mec.gub.uy.
RCBOT_API_URL=
# Адреса входа и старой системы SAE заданы в коде; менять только если сайт их сменил.
# RCBOT_LOGIN_URL=https://bpmgob.mec.gub.uy/autenticacion/login?redirect=...
# RCBOT_SAE_URL=https://sae.mec.gub.uy/sae/agendarReserva/Paso1.xhtml?e=9&a=82

# Жёсткий минимум в коде — 10 с; меньшее значение отклоняется (SPEC.md, 0.3, правило 3).
RCBOT_POLL_INTERVAL_SEC=20
RCBOT_POLL_JITTER=0.10
RCBOT_REQUEST_TIMEOUT_SEC=8
RCBOT_RELOGIN_MAX_PER_HOUR=6

RCBOT_TG_REPEAT_SEC=60
RCBOT_TG_REPEAT_MAX=30
RCBOT_NTFY_SERVER=https://ntfy.sh
RCBOT_NTFY_REPEAT_SEC=120
RCBOT_NTFY_REPEAT_MAX=10
RCBOT_CALL_REPEAT_SEC=180
RCBOT_CALL_REPEAT_MAX=5
RCBOT_CALL_LANG=ru-RU-Standard-A

RCBOT_TIMEZONE=America/Montevideo
RCBOT_DAILY_REPORT_HOUR=9
# Sentry выключен по умолчанию (SPEC.md, 2.6). DSN нужен, только если RCBOT_SENTRY_ENABLED=true.
RCBOT_SENTRY_ENABLED=false
RCBOT_SENTRY_DSN=
# Необязательно: адрес внешнего «сторожа» (SPEC.md, 6.1).
RCBOT_WATCHDOG_URL=
# Чтение старой системы SAE (D6) пока не реализовано: флаг ничего не включает и список хостов не расширяет.
RCBOT_SAE_SOURCE_ENABLED=false
RCBOT_HEADLESS=true
# Браузер для входа и запасного чтения календаря (решение R8): auto — Google Chrome, если его нет —
# Microsoft Edge, если и его нет — встроенный Chromium Playwright. Можно закрепить один:
# chrome, msedge или chromium (тогда запасных вариантов нет).
RCBOT_BROWSER=auto

# Журнал наблюдения (решение R6): каждая проверка, каждое действие, окна записи, состояние.
# Пусто — папка rcbot-journal на рабочем столе. Секретов и номеров заявки в журнале нет.
RCBOT_JOURNAL_ENABLED=true
RCBOT_JOURNAL_DIR=
# Писать журнал в отдельном потоке: зависший диск (антивирус, OneDrive) не тормозит тревоги.
RCBOT_JOURNAL_BACKGROUND=true
# Больше MAX_GB → самые старые дни удаляются, пока не останется TRIM_TO_GB.
RCBOT_JOURNAL_MAX_GB=10
RCBOT_JOURNAL_TRIM_TO_GB=5
